{
  "name": "autonomous-income-node",
  "version": "0.1.0",
  "description": "Autonomous AI agent for self-sustaining income generation — based on Conway-Research/automaton architecture",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"const fs=require('fs');const path=require('path');const srcMig='src/research/state/migrations';const destMig='dist/research/state/migrations';if(fs.existsSync(srcMig)){fs.mkdirSync(destMig,{recursive:true});fs.readdirSync(srcMig).filter(f=>f.endsWith('.sql')).forEach(f=>fs.copyFileSync(path.join(srcMig,f),path.join(destMig,f)));console.log('Copied migrations to dist')}\"",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "start": "node dist/agent/index.js",
    "dev": "tsx watch src/agent/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "backup": "node dist/dashboard/index.js backup",
    "status": "node dist/dashboard/index.js status",
    "migrate": "node dist/state/database.js migrate",
    "backtest": "tsx src/backtester/cli.ts",
    "backtest:funding": "tsx src/evolution/funding-arb/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@fastify/cors": "^9.0.1",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@okxweb3/x402-core": "^0.1.0",
    "@okxweb3/x402-evm": "^0.2.1",
    "@okxweb3/x402-express": "^0.1.1",
    "@solana/web3.js": "^1.95.3",
    "@types/dockerode": "^4.0.1",
    "@uniswap/sdk-core": "^5.7.0",
    "@uniswap/v3-sdk": "^3.14.0",
    "axios": "^1.7.7",
    "better-sqlite3": "^11.9.0",
    "bip39": "^3.1.0",
    "cheerio": "^1.0.0",
    "chokidar": "^4.0.1",
    "diff": "^7.0.0",
    "dockerode": "^5.0.1",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.2",
    "fastify": "^4.28.1",
    "hdkey": "^2.1.0",
    "ioredis": "^5.4.1",
    "node-cron": "^3.0.3",
    "openai": "^6.47.0",
    "pg": "^8.22.0",
    "siwe": "^2.3.0",
    "uuid": "^10.0.0",
    "winston": "^3.14.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/diff": "^6.0.0",
    "@types/node": "^22.7.5",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.20.4",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "@vitest/coverage-v8": "^2.1.3",
    "eslint": "^9.12.0",
    "fast-check": "^3.22.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
