# ============================================================
# AUTONOMOUS INCOME NODE — Environment Variables
# ============================================================
# Copia este archivo como .env y completa los valores reales
# NUNCA subas .env a Git
# ============================================================

# --- OWNER (mock data para dev) ---
OWNER_NAME="Mauricio Quintero"
OWNER_EMAIL="niklaussmauricio@gmail.com"

# --- SECURITY ---
# Password para cifrar el keystore de la wallet Ethereum (AES-256)
# CAMBIAR por un valor secreto real antes de usar en producción
WALLET_PASSWORD="CHANGE_ME_TO_A_SECURE_PASSWORD"

# --- LLM PROVIDER (elige uno) ---
# Obtener en: https://console.anthropic.com → Settings → API Keys
ANTHROPIC_API_KEY=""
# Alternativa: https://platform.openai.com → API Keys
OPENAI_API_KEY=""
# Modelo a usar (claude-3-5-sonnet-20241022 | gpt-4o | claude-3-haiku-20240307)
LLM_MODEL="claude-3-5-sonnet-20241022"
LLM_PROVIDER="anthropic"

# --- BLOCKCHAIN RPC ---
# Obtener en: https://alchemy.com → Create App → Base Mainnet
RPC_PROVIDER_URL=""
# Fallback RPC (used when primary fails). Default: https://mainnet.base.org
RPC_PROVIDER_URL_FALLBACK="https://mainnet.base.org"
# Testnet (Base Sepolia) para desarrollo
RPC_PROVIDER_URL_TESTNET="https://sepolia.base.org"
# Red blockchain objetivo (base | ethereum | base-sepolia)
CHAIN_ID="8453"
CHAIN_NAME="base"

# --- SERVIDOR HTTP ---
API_PORT=3000
METRICS_PORT=9090
API_HOST="0.0.0.0"

# --- ONCHAIN IDENTITY ---
# Si es true, simula el registro ERC-8004 sin enviar transacciones reales.
# Cambiar a false en producción con CHAIN_ID=8453 para registro real.
MOCK_ONCHAIN_IDENTITY=true

# --- REACT LOOP ---
# Intervalo entre ciclos en ms (mínimo 1000)
REACT_LOOP_INTERVAL_MS=10000
# Máximo de acciones concurrentes por ciclo
REACT_LOOP_MAX_ACTIONS=10
# Timeout de llamada LLM en ms
LLM_TIMEOUT_MS=30000

# --- RUTAS ---
DB_PATH="./data/agent.db"
KEYS_PATH="./keys"
BACKUP_DIR="./data/backups"
LOG_LEVEL="info"

# --- REDIS (opcional, mejora performance) ---
# Dejar vacío para usar solo SQLite
REDIS_URL=""
# REDIS_URL="redis://localhost:6379"

# --- TRADING (mock values para dev) ---
UNISWAP_ROUTER_ADDRESS="0xE592427A0AEce92De3Edee1F18E0157C05861564"
MIN_PROFIT_THRESHOLD_USDC="500000"
DEFAULT_SLIPPAGE_PCT="0.5"
MAX_TRADE_EXPOSURE_PCT="20"

# --- SOCIAL (opcional, para módulo de contenido) ---
# Obtener en: https://developer.twitter.com → Projects & Apps → Keys
TWITTER_API_KEY=""
TWITTER_API_SECRET=""
TWITTER_BEARER_TOKEN=""
TWITTER_ACCESS_TOKEN=""
TWITTER_ACCESS_SECRET=""
MAX_POSTS_PER_DAY="10"

# --- DOCKER (para módulo de replicación) ---
# En Linux: /var/run/docker.sock
# En Windows con Docker Desktop: //./pipe/docker_engine
DOCKER_SOCKET_PATH="/var/run/docker.sock"
AGENT_IMAGE="autonomous-income-node:latest"
MAX_CHILD_AGENTS="5"
CHILD_INITIAL_FUNDING_USDC="50"

# --- SURVIVAL TIERS ---
TIER4_MIN_USDC="1000"
TIER3_MIN_USDC="100"
TIER2_MIN_USDC="10"

# --- CLOUDFLARE TUNNEL (reemplaza ngrok para URL permanente gratuita) ---
# Obtener en: https://one.dash.cloudflare.com → Zero Trust → Tunnels → Create
CLOUDFLARE_TUNNEL_TOKEN=""
# Tu dominio DuckDNS o custom domain que apunta al tunnel
TUNNEL_HOSTNAME=""

# --- 1INCH API (para cotizaciones DEX) ---
ONEINCH_API_KEY=""

# --- TELEGRAM (para social + daily report) ---
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# --- DISCORD (fallback social) ---
DISCORD_WEBHOOK_URL=""

# ─── Hybrid Sniper (satélite de micro-cap, Phase 0 Shadow Testing) ────────────
SNIPER_ENABLED=false
SNIPER_RISK_BUDGET_USDC=15      # Presupuesto lógico total en USDC
SNIPER_TRADE_SIZE_USDC=5        # Tamaño por trade en USDC
SNIPER_MAX_LOSS_STREAK=2        # Pérdidas consecutivas antes del Circuit Breaker
SNIPER_TP_PCT=15                # Take Profit %
SNIPER_SL_PCT=5                 # Stop Loss %
SNIPER_POLL_INTERVAL_MS=30000   # Intervalo de polling DexScreener (ms)
BITQUERY_API_KEY=               # API Key de Bitquery (dejar vacío para desactivar)

# ─── AdaptiveEvolver (auto-implementación autónoma de estrategias) ─────────────
# Cuando el Research Agent descubre una oportunidad viable, el AdaptiveEvolver
# pide al LLM que genere código TypeScript, lo prueba en sandbox con pnpm test,
# y si los tests pasan lo aplica automáticamente a src/strategies/auto-generated/
#
# PELIGRO: con DRY_RUN=false el agente modifica su propio código en producción.
# Requiere Tier 3+ y respeta un rate limit de 3 modificaciones por 24h.
ADAPTIVE_EVOLVER_DRY_RUN=true         # true = solo logs (seguro), false = aplica cambios reales
ADAPTIVE_EVOLVER_INTERVAL_MS=3600000  # Intervalo entre evaluaciones (ms) — default: 1 hora
ADAPTIVE_EVOLVER_MAX_PER_CYCLE=1      # Máx implementaciones por ciclo (recomendado: 1)
ADAPTIVE_EVOLVER_MIN_SCORE=75         # Score mínimo de viabilidad para intentar (0-100)
